name: RR Site Intelligence QA
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: "0 12 * * 1"
  workflow_dispatch:
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Rebuild smart assets
        run: |
          npm run smart:bundle
          npm run smart:index
          npm run search:index
      - name: Verify generated assets are committed
        run: git diff --exit-code
      - name: JavaScript syntax
        run: |
          node --check assets/site-brain.js
          node --check assets/brain-worker.js
          node --check assets/smart-guide.js
          node --check assets/smart-search.js
          node --check assets/copilot.js
          node --check assets/site-search.js
          node --check assets/platform.js
          node --check service-worker.js
      - name: Static site validation
        run: python scripts/validate_site.py
      - name: Accessibility audit
        run: python scripts/accessibility_audit.py
      - name: Performance budget
        run: python scripts/performance_budget.py
      - name: Tools integrity
        run: python scripts/tools_integrity.py
      - name: Dependency audit
        run: npm audit --audit-level=high
      - name: Public availability check
        if: github.event_name == 'schedule'
        run: python scripts/public_smoke.py
